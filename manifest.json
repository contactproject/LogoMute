{
  "manifest_version": 3,
  "name": "LogoMute — TV Commercial Muter",
  "short_name": "LogoMute",
  "version": "0.10.8",
  "minimum_chrome_version": "116",
  "description": "Desktop Chrome extension that locally mutes a TV tab when a saved channel logo disappears; does not hide or skip ads.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LogoMute — TV Commercial Muter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-fullscreen-logo": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Save a logo sample from the full-screen TV picture"
    }
  }
}
